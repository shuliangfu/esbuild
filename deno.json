{
  "name": "@dreamer/esbuild",
  "version": "1.3.0",
  "license": "Apache-2.0",
  "description": "High-performance build tool library compatible with Deno, Bun, and Node.js 22+, providing full-stack compilation, bundling, resource processing, optimization, and more, with subpath on-demand imports.",
  "repository": {
    "type": "git",
    "url": "https://github.com/shuliangfu/esbuild.git"
  },
  "exports": {
    ".": "./src/mod.ts",
    "./css-injector": "./src/utils/css-injector.ts",
    "./client": "./src/entry-client.ts",
    "./server": "./src/entry-server.ts",
    "./bundle": "./src/entry-bundle.ts",
    "./builder": "./src/entry-builder.ts"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "src/**/*.json",
      "LICENSE",
      "NOTICE",
      "README.md"
    ],
    "exclude": [
      "**/*.test.ts",
      "**/*.spec.ts",
      "**/test/**",
      "**/tests/**"
    ]
  },
  "lint": {
    "include": [
      "src/"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-explicit-any"
      ]
    }
  },
  "imports": {
    "@dreamer/i18n": "jsr:@dreamer/i18n@^1.1.2",
    "@dreamer/console": "jsr:@dreamer/console@^1.1.0",
    "@dreamer/logger": "jsr:@dreamer/logger@^1.1.0",
    "@dreamer/runtime-adapter": "jsr:@dreamer/runtime-adapter@^1.2.2",
    "@dreamer/image": "jsr:@dreamer/image@^1.1.0",
    "@dreamer/test": "jsr:@dreamer/test@^1.2.3",
    "esbuild": "npm:esbuild@^0.27.7",
    "postcss": "npm:postcss@^8.5.10",
    "autoprefixer": "npm:autoprefixer@^10.5.0",
    "cssnano": "npm:cssnano@^7.1.7"
  },
  "minimumDependencyAge": 0,
  "nodeModulesDir": "auto",
  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".deno",
    "tests/data"
  ]
}
